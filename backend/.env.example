NODE_ENV=development
PORT=5000

# MongoDB connection string (local or Atlas) — required
MONGO_URI=mongodb://localhost:27017/hrms

# JWT / auth secrets — generate your own random strings, do not reuse examples
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=15m
REFRESH_SECRET=change-me-to-a-different-long-random-string
REFRESH_EXPIRE=7d
COOKIE_SECRET=change-me-to-another-long-random-string

# Cloudinary (optional — only needed if you swap the local disk document
# storage in middlewares/uploadDocument.js for Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (required for OTP/email verification/password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=admin@hrms.com
SMTP_FROM=HRMS Nova <no-reply@hrms.com>

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

OTP_EXPIRE_MINUTES=10
RESET_PASSWORD_EXPIRE=15m

# REDIS_URL=redis://localhost:6379
